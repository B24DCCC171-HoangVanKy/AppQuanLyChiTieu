<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:focusableInTouchMode="true" android:padding="24dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center_vertical" android:orientation="horizontal" android:layout_marginTop="20dp">
            <ImageView android:layout_width="44dp" android:layout_height="44dp"
                android:background="@drawable/bg_logo" android:padding="10dp"
                android:src="@drawable/ic_wallet" android:tint="@color/white" android:importantForAccessibility="no" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="@string/app_name" android:textSize="21sp"
                android:textColor="@color/primary_color" android:textStyle="bold" />
        </LinearLayout>
        <TextView style="@style/SectionLabel" android:layout_marginTop="32dp" android:text="@string/personal_finance" />
        <TextView style="@style/AppTitle" android:layout_marginTop="8dp"
            android:text="@string/welcome_title" android:textSize="34sp" />
        <TextView style="@style/AppSubtitle" android:layout_marginTop="8dp" android:text="@string/login_subtitle" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/bg_card"
            android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/AppTitle" android:text="@string/login" android:textSize="22sp" />
            <TextView style="@style/FieldLabel" android:layout_marginTop="24dp" android:text="@string/username" />
            <EditText android:id="@+id/etUsername" style="@style/FormInput"
                android:autofillHints="username" android:hint="@string/username_hint"
                android:imeOptions="actionNext" android:inputType="text" android:maxLines="1" />
            <TextView style="@style/FieldLabel" android:layout_marginTop="18dp" android:text="@string/password" />
            <EditText android:id="@+id/etPassword" style="@style/FormInput"
                android:autofillHints="password" android:hint="@string/password_hint"
                android:imeOptions="actionDone" android:inputType="textPassword" android:maxLines="1" />
            <TextView android:id="@+id/tvError" style="@style/AppSubtitle" android:layout_marginTop="12dp"
                android:accessibilityLiveRegion="polite" android:textColor="@color/red_delete" android:visibility="gone" />
            <Button android:id="@+id/btnLogin" style="@style/PrimaryButton"
                android:layout_marginTop="24dp" android:text="@string/login" />
        </LinearLayout>
        <Button android:id="@+id/btnOpenRegister" style="@style/TextButton"
            android:layout_width="match_parent" android:layout_marginTop="16dp" android:text="@string/open_register" />
    </LinearLayout>
</ScrollView>

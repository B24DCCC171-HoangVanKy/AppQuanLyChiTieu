<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="20dp">
        <Button android:id="@+id/btnBack" style="@style/TextButton"
            android:text="@string/back_to_list" app:icon="@drawable/ic_back" />
        <TextView style="@style/AppTitle" android:layout_marginTop="8dp" android:text="@string/detail_title" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:background="@drawable/bg_card"
            android:gravity="center_horizontal" android:orientation="vertical" android:padding="24dp">
            <ImageView android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/bg_accent_soft" android:padding="12dp"
                android:src="@drawable/ic_wallet" android:tint="@color/accent_color" android:importantForAccessibility="no" />
            <TextView android:id="@+id/tvDetailName" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="18dp" android:gravity="center" android:textColor="@color/text_primary"
                android:textSize="23sp" android:textStyle="bold" />
            <TextView style="@style/AppSubtitle" android:layout_marginTop="16dp"
                android:gravity="center" android:text="@string/payment_amount" />
            <TextView android:id="@+id/tvDetailAmount" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/accent_color"
                android:textSize="34sp" android:textStyle="bold" />
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:orientation="horizontal" android:baselineAligned="false">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginEnd="6dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/AppSubtitle" android:text="@string/category" />
                <TextView android:id="@+id/tvDetailCategory" style="@style/DetailValue" android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="6dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="18dp">
                <TextView style="@style/AppSubtitle" android:text="@string/expense_date" />
                <TextView android:id="@+id/tvDetailDate" style="@style/DetailValue" android:textSize="15sp" android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:background="@drawable/bg_card" android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/AppSubtitle" android:text="@string/note" />
            <TextView android:id="@+id/tvDetailNote" style="@style/DetailValue" />
        </LinearLayout>
        <Button android:id="@+id/btnDelete" style="@style/DeleteButton" android:layout_marginTop="24dp"
            android:text="@string/delete_expense" app:icon="@drawable/ic_delete"
            app:iconTint="@color/red_delete" app:iconGravity="textStart" />
    </LinearLayout>
</ScrollView>

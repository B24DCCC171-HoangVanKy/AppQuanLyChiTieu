<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_card" android:minHeight="104dp" android:gravity="center_vertical"
    android:orientation="horizontal" android:padding="16dp">
    <ImageView android:layout_width="38dp" android:layout_height="38dp"
        android:background="@drawable/bg_accent_soft" android:padding="9dp"
        android:src="@drawable/ic_wallet" android:tint="@color/accent_color" android:importantForAccessibility="no" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.3"
        android:layout_marginStart="12dp" android:layout_marginEnd="8dp" android:orientation="vertical">
        <TextView android:id="@+id/tvItemName" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvItemCategory" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:textColor="@color/text_secondary" android:textSize="13sp" />
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
        android:layout_weight="1" android:orientation="vertical" android:gravity="end">
        <TextView android:id="@+id/tvItemAmount" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="end" android:textColor="@color/primary_color" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/tvItemDate" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="6dp" android:gravity="end" android:textColor="@color/text_secondary" android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
